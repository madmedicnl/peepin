pkgbase = peepin-git
	pkgdesc = A tiny image and video viewer with a terminal feel
	pkgver = r13.7880db6
	pkgrel = 1
	url = https://github.com/madmedicnl/peepin
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libxkbcommon
	depends = libglvnd
	optdepends = mpv: video
	optdepends = imagemagick: heic, jxl, psd, svg and camera raw
	optdepends = graphicsmagick: the same formats, through gm
	optdepends = libheif: heic and heif, through heif-convert
	optdepends = libjxl: jpeg xl, through djxl
	optdepends = libvips: several formats, through vips
	optdepends = xorg-xwayland: video inside the window, with its bar
	provides = peepin
	conflicts = peepin
	source = peepin-git::git+https://github.com/madmedicnl/peepin
	sha256sums = SKIP

pkgname = peepin-git
